<patch-1.0 appVersion="1.1.0">
   <obj type="raw_ctl" name="ctl" x="14" y="14">
      <params/>
      <attribs>
         <combo attributeName="startpreset" selection="0 init"/>
         <combo attributeName="testnote" selection="C3 held"/>
      </attribs>
   </obj>
   <obj type="raw_voice" name="mono" x="14" y="196">
      <params/>
      <attribs/>
   </obj>
   <obj type="audio/out stereo" name="dac" x="588" y="196">
      <params/>
      <attribs/>
   </obj>
   <nets>
      <net>
         <source obj="mono" outlet="out"/>
         <dest obj="dac" inlet="left"/>
         <dest obj="dac" inlet="right"/>
      </net>
   </nets>
   <settings>
      <subpatchmode>no</subpatchmode>
   </settings>
</patch-1.0>
