<patch-1.0 appVersion="1.1.0">
   <obj type="soliton_ctl" name="ctl" x="14" y="14">
      <params/>
      <attribs>
         <combo attributeName="startpreset" selection="0 init"/>
      </attribs>
   </obj>
   <obj type="soliton_voice" name="v0" x="14" y="112">
      <params/>
      <attribs>
         <combo attributeName="autoplay" selection="C3"/>
      </attribs>
   </obj>
   <obj type="dev/probe" name="probe" x="196" y="112">
      <params/>
      <attribs>
         <spinner attributeName="id" value="0"/>
      </attribs>
   </obj>
   <nets>
      <net>
         <source obj="v0" outlet="wave"/>
         <dest obj="probe" inlet="in"/>
      </net>
   </nets>
   <settings>
      <subpatchmode>no</subpatchmode>
   </settings>
   <notes><![CDATA[One soliton voice (preset 0, C3, velocity 0.8) into dev/probe: compare its log line with ./tests/render_soliton <dir> probe.]]></notes>
</patch-1.0>
