<patch-1.0 appVersion="1.1.0">
   <obj type="aeolian_ctl" name="ctl" x="14" y="14">
      <params/>
      <attribs>
         <combo attributeName="startpreset" selection="0 breeze"/>
      </attribs>
   </obj>
   <obj type="aeolian_harp" name="harp" x="14" y="112">
      <params/>
      <attribs/>
   </obj>
   <obj type="dev/probe" name="probe" x="196" y="112">
      <params/>
      <attribs>
         <spinner attributeName="id" value="0"/>
      </attribs>
   </obj>
   <nets>
      <net>
         <source obj="harp" outlet="l"/>
         <dest obj="probe" inlet="in"/>
      </net>
   </nets>
   <settings>
      <subpatchmode>no</subpatchmode>
   </settings>
   <notes><![CDATA[aeolian_harp (preset 0, no effects) into dev/probe: compare its log line with ./tests/render_aeolian <dir> probe.]]></notes>
</patch-1.0>
