<patch-1.0 appVersion="1.1.0">
   <obj type="west_ctl" name="ctl" x="14" y="14">
      <params/>
      <attribs>
         <combo attributeName="test" selection="off"/>
      </attribs>
   </obj>
   <obj type="patch_switch" name="switch" x="196" y="14">
      <params/>
      <attribs/>
   </obj>
   <obj type="west_voices" name="voices" x="14" y="196">
      <params/>
      <attribs/>
   </obj>
   <obj type="audio/out stereo" name="dac" x="196" y="196">
      <params/>
      <attribs/>
   </obj>
   <nets>
      <net>
         <source obj="voices" outlet="out"/>
         <dest obj="dac" inlet="left"/>
         <dest obj="dac" inlet="right"/>
      </net>
   </nets>
   <settings>
      <subpatchmode>no</subpatchmode>
      <MidiChannel>1</MidiChannel>
   </settings>
   <notes><![CDATA[westcoast v1: four voices, a complex oscillator into a low-pass gate after Buchla's 259/292/281/266. west_ctl (lib/west_ctl.h) maps the Launchkey 49 MK3; west_voices (lib/west_voice.h) are the voices.]]></notes>
</patch-1.0>
