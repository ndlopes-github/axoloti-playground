<objdefs appVersion="1.1.0">
   <obj.normal id="freak_voice" uuid="fa7cfc09-4bfd-4396-acaa-6aa62ad8050b">
      <sDescription>One voice of the freak synth: Braids digital oscillator -> state-variable filter (LP/BP/HP) -> amp, with an amp envelope, a mod envelope (to cutoff and optionally timbre, can cycle) and glide. Its settings come from the control bus of launchkey_ctl, so it only works next to one. Made for a polyphonic subpatch: wire midi/in/keyb note, gate and velocity. The code is lib/freak_voice.h, shared with the host renderer.</sDescription>
      <author>Axoloti project</author>
      <license>MIT</license>
      <inlets>
         <frac32.bipolar name="note" description="from midi/in/keyb"/>
         <bool32 name="gate" description="from midi/in/keyb"/>
         <frac32.positive name="velocity" description="from midi/in/keyb"/>
      </inlets>
      <outlets>
         <frac32buffer name="wave"/>
      </outlets>
      <displays/>
      <params/>
      <attribs/>
      <includes>
         <include>../lib/freak_voice.h</include>
         <include>../third_party/braids/digital_oscillator.cc</include>
      </includes>
      <code.declaration><![CDATA[// Trivially destructible (README: atexit). Not named "voice": the
// polyphonic subpatch generates a class of that name.
freak::Voice fvoice;
float out[BUFSIZE];]]></code.declaration>
      <code.init><![CDATA[fvoice.init();]]></code.init>
      <code.krate><![CDATA[// Axoloti note = (MIDI - 64) << 21; frac32 full scale = 1 << 27.
fvoice.render(64.0f + inlet_note * (1.0f / (1 << 21)), inlet_gate > 0,
             inlet_velocity * (1.0f / (1 << 27)), out);
for (int i = 0; i < BUFSIZE; i++)
   outlet_wave[i] = (int32_t)(out[i] * (1 << 27));]]></code.krate>
   </obj.normal>
</objdefs>
