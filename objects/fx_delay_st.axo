<objdefs appVersion="1.1.0">
   <obj.normal id="fx_delay_st" uuid="b25293c0-249c-48b5-944f-049345dd6f6d">
      <sDescription>Stereo feedback delay (two of fx_delay's lines, one per side, same settings): 10 ms .. 1.5 s, feedback up to 0.95 with a low-pass in the loop, and a wet/dry mix. Time, feedback, mix and on/off come from the control bus (freak::bus). 600 KB of SDRAM.</sDescription>
      <author>Axoloti project</author>
      <license>MIT</license>
      <inlets>
         <frac32buffer name="l"/>
         <frac32buffer name="r"/>
      </inlets>
      <outlets>
         <frac32buffer name="l"/>
         <frac32buffer name="r"/>
      </outlets>
      <displays/>
      <params/>
      <attribs/>
      <includes>
         <include>../lib/launchkey_ctl.h</include>
      </includes>
      <code.declaration><![CDATA[static const int32_t kLen = 76800;  // 1.6 s at 48 kHz
freak::Delay dl, dr;
float wet;  // smoothed wet gain, so on/off and mix changes do not click]]></code.declaration>
      <code.init><![CDATA[dl.init((float *)sdram_malloc(kLen * sizeof(float)), kLen);  // NULL: that side silent
dr.init((float *)sdram_malloc(kLen * sizeof(float)), kLen);
wet = 0.0f;]]></code.init>
      <code.krate><![CDATA[const freak::Bus &b = freak::bus();
const float d = b.delay_t * freak::kSampleRate;
for (int i = 0; i < BUFSIZE; i++) {
   wet += 0.002f * (b.delay_mix - wet);  // ~10 ms smoothing
   const float xl = inlet_l[i] * (1.0f / (1 << 27)), xr = inlet_r[i] * (1.0f / (1 << 27));
   // Off: feed silence, so the echoes die away instead of stopping dead.
   const float yl = dl.process(b.delay_on ? xl : 0.0f, d, b.delay_fb);
   const float yr = dr.process(b.delay_on ? xr : 0.0f, d, b.delay_fb);
   outlet_l[i] = (int32_t)((xl + wet * yl) * (1 << 27));
   outlet_r[i] = (int32_t)((xr + wet * yr) * (1 << 27));
}]]></code.krate>
   </obj.normal>
</objdefs>
